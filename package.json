{
  "name": "tandem",
  "type": "module",
  "private": true,
  "version": "0.1.7",
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
    "migrate": "bun src/db/migrate.ts up",
    "migrate:down": "bun src/db/migrate.ts down",
    "seed": "bun src/db/seed.ts",
    "check": "tsc --noEmit",
    "verify:runtime": "bun test/runtime.ts"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@biomejs/biome": "latest",
    "typescript": "^5"
  }
}
