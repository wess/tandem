PORT=3000

# Castle provisions Postgres — point this at it (or the compose `db` service).
DATABASE_URL=postgres://tandem:tandem@localhost:5432/tandem
DB_POOL_SIZE=5

# Session signing secret — change this.
AUTH_SECRET=change-me-in-production

# The first account's login, seeded on first `bun run seed`. Additional users
# get their own isolated workspace just-in-time on first SSO login.
ADMIN_EMAIL=me@example.com
ADMIN_PASSWORD=change-me

# Provider keys live on the server; clients never receive them. Keys are per-user
# (set in each user's Settings) — these env vars are the shared fallback used
# when a user hasn't set their own.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
