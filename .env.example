PORT=3000

# Castle provisions Postgres — point this at it (or the compose `db` service).
DATABASE_URL=postgres://tandem:tandem@localhost:5432/tandem
DB_POOL_SIZE=5

# Session signing secret — change this.
AUTH_SECRET=change-me-in-production

# The single human's login, seeded on first `bun run seed`.
ADMIN_EMAIL=me@example.com
ADMIN_PASSWORD=change-me

# Provider keys live on the server; clients never receive them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
